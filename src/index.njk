<link rel="stylesheet" href="/css/home.css">

<div class="dropdown">
  <button onclick="myFunction()" class="dropbtn">All Categories</button>

  <div id="myDropdown" class="dropdown-content">
    {% for tag, notes in collections.tags %}
      <a href="/tags/{{ tag }}/">&#127991 {{ tag }}</a>
    {% endfor %}
  </div>
</div>

<h1 class=center>All Notes</h1>

<div class="notes-container">

  {% for note in collections.notes %}
    <a class=notes-container href="{{ note.url }}">{{ note.data.title }}</a>
  {% endfor %}
</div>

<script>
function myFunction() {
  document.getElementById("myDropdown").classList.toggle("show");
}

window.onclick = function(event) {
  if (!event.target.matches('.dropbtn')) {
    let dropdowns = document.getElementsByClassName("dropdown-content");
    for (let d of dropdowns) {
      d.classList.remove('show');
    }
  }
}
</script>