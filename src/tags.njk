---
pagination:
  data: collections.tags
  size: 1
  alias: tag
permalink: "/tags/{{ tag }}/"
---

<link rel="stylesheet" href="/css/style.css">

<a class=big-link href=/>< home</a>

<h1>Tag: {{ tag }}</h1>

<ul>
{% for note in collections.tags[tag] %}
  <li>
    <a href="{{ note.url }}">{{ note.data.title }}</a>
  </li>
{% endfor %}
</ul>